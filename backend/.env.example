NODE_ENV=development
PORT=5000

# --- Database ---
# Option A: full URL (preferred on Render / cloud Postgres). When set, host/port/etc. are ignored.
#   Example (Render Postgres): postgresql://user:pass@host/dbname
# DATABASE_URL=
# Force a dialect explicitly when you don't use DATABASE_URL ("mysql" or "postgres").
# DB_DIALECT=mysql

# Option B: discrete fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exchange_tunnel
DB_USER=root
DB_PASSWORD=your_mysql_password
# Set true for cloud DB proxies that require TLS (auto-on for Postgres URLs).
DB_SSL=false
# Optional; default true when DB_SSL=true. Set false only if your host requires it.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNC_ALTER=false

# JWT_SECRET and ENCRYPTION_SECRET are REQUIRED in production (min 32 chars, not these examples);
# the server refuses to start otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_secure_secret
JWT_EXPIRES_IN=7d
# Optional: separate key for admin-panel tokens (otherwise derived from JWT_SECRET). Must differ from JWT_SECRET.
ADMIN_JWT_SECRET=
# Admin panel login (/admin)
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=

# Encrypts stored Telegram user sessions. Changing it invalidates saved sessions.
ENCRYPTION_SECRET=replace_with_32_char_secret_key____

# Reverse-proxy hops to trust for client IPs (rate limiting). Render = 1. Default: 1 in production.
# TRUST_PROXY=1

# Same token as the bot used for the Telegram Login widget. Required for /auth/telegram, getChat, getChatMember.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Bot username without @ — used for deep-link login URL construction.
TELEGRAM_BOT_NAME=YourBotName
# Random secret you choose — passed as X-Telegram-Bot-Api-Secret-Token when calling setWebhook.
# REQUIRED: the webhook rejects all updates without it. For local experiments only you may set
# TELEGRAM_WEBHOOK_ALLOW_INSECURE=true (ignored in production).
# Deep-link login uses inline "Confirm" buttons, so do not exclude "callback_query" in allowed_updates.
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret
# Optional SOCKS5 proxies the MTProto bridge may use, as host:port,host2:port2. Anything else is ignored.
# TELEGRAM_PROXY_ALLOWLIST=
# Python executable for MTProto bridge (Telethon user-auth flow)
TELEGRAM_MTPROTO_PYTHON=python
# Optional: server-side MTProto app credentials to avoid sending apiId/apiHash from clients.
TELEGRAM_MTPROTO_API_ID=
TELEGRAM_MTPROTO_API_HASH=

# Comma-separated allowed origins (production: include your Vercel URL)
CORS_ORIGIN=http://localhost:5173,https://the-exchange-tunnel.vercel.app

DAILY_EARN_LIMIT=500
LIKE_REWARD=5
COMMENT_REWARD=10
SHARE_REWARD=15

# Public site URL (checkout return URLs). First CORS_ORIGIN entry is used if unset.
FRONTEND_URL=http://localhost:5173

# PayPal Subscriptions (sandbox first: https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
