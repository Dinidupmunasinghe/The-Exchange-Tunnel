{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd \"Facebook Engagement Exchange UI\" && npm install",
  "buildCommand": "cd \"Facebook Engagement Exchange UI\" && npm run build",
  "outputDirectory": "Facebook Engagement Exchange UI/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://the-exchange-tunnel.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
