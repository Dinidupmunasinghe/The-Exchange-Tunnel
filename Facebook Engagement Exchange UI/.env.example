# Local dev: Vite proxies /api → localhost:5000. Production: Vercel rewrites /api → Render (see vercel.json).
VITE_API_BASE_URL=/api
# Optional override, e.g. https://the-exchange-tunnel.onrender.com/api
# Username of the Telegram bot (no @) — for https://core.telegram.org/widgets/login
VITE_TELEGRAM_BOT_NAME=
